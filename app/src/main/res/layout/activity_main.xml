<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_color"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

    <!-- Header with Instagram Time and Mode Toggle -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@color/header_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_app_mark"
                android:importantForAccessibility="no" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:fontFamily="sans-serif-medium"
            android:textSize="22sp"
            android:textColor="@color/primary_text"
            android:layout_marginBottom="0dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/balance_background"
            android:padding="16dp"
            android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/your_scroll_balance"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/instagram_color" />

                <TextView
                    android:id="@+id/instagramTimeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/initial_balance"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="28sp"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="@color/primary_text" />

                <TextView
                    android:id="@+id/dailyStatsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="13sp"
                    android:textColor="@color/secondary_text" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openInstagramButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/instagram_color"
                    android:text="@string/open_instagram"
                    android:textColor="@android:color/white"
                    app:icon="@drawable/ic_arrow_out"
                    app:iconGravity="textEnd"
                    app:iconTint="@color/white" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/guardSettingsButton"
            style="?attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/guard_disabled"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:icon="@drawable/ic_shield"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconTint="@color/progress_color"
            android:textColor="@color/progress_color" />

        <!-- Mode Selection -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="4dp"
            android:background="@color/header_background"
            app:tabMode="fixed"
            app:tabTextAppearance="@style/TextAppearance.Workout2Scroll.Tab"
            app:tabTextColor="@color/secondary_text"
            app:tabSelectedTextColor="@color/progress_color"
            app:tabIndicatorHeight="3dp"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorColor="@color/progress_color">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/live_camera" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/upload_video" />

        </com.google.android.material.tabs.TabLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/exerciseToggleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:checkedButton="@id/squatsOption">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/squatsOption"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/squats_option"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:paddingHorizontal="8dp"
                android:minHeight="48dp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pushupsOption"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pushups_option"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:paddingHorizontal="8dp"
                android:minHeight="48dp"
                app:cornerRadius="8dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

    </LinearLayout>

    <!-- Content Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/workout_preview_height"
        android:layout_marginHorizontal="20dp"
        app:cardBackgroundColor="@color/card_background"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/outline_color"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <!-- Live Camera View -->
        <FrameLayout
            android:id="@+id/cameraView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/camera_background"
            android:visibility="visible">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_camera"
                android:importantForAccessibility="no"
                app:tint="@color/outline_color" />

            <!-- Camera Preview -->
            <androidx.camera.view.PreviewView
                android:id="@+id/cameraPreviewView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:scaleType="fitCenter"
                app:implementationMode="compatible" />

            <!-- Pose Detection Overlay -->
            <com.workout2scroll.ui.PoseOverlayView
                android:id="@+id/poseOverlayView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>

        <!-- Video Upload View -->
        <LinearLayout
            android:id="@+id/videoUploadLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <!-- Video Selection -->
            <ImageView
                android:id="@+id/ivVideoIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_upload"
                android:importantForAccessibility="no"
                app:tint="@color/progress_color"
                android:layout_marginBottom="16dp" />

<TextView
    android:id="@+id/tvVideoHint"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:text="@string/workout_video"
    android:textColor="@color/primary_text"
    android:fontFamily="sans-serif-medium"
    android:textSize="20sp"
    android:gravity="center" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectVideoButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/start_color"
                    app:icon="@drawable/ic_upload"
                    app:iconGravity="textStart"
                    android:text="@string/select_video"
                    android:textColor="@android:color/white" />

                </LinearLayout>

            <!-- Video Processing Layout -->
            <LinearLayout
                android:id="@+id/videoProcessingLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/processingStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/processing_video"
                    android:gravity="center"
                    android:textSize="16sp"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="@color/primary_text" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/processingProgressBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:indeterminate="false"
                    app:trackCornerRadius="2dp"
                    app:trackThickness="4dp"
                    app:trackColor="@color/outline_color"
                    app:indicatorColor="@color/start_color"
                    android:progress="0" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancelProcessingButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="24dp"
                    app:cornerRadius="8dp"
                    android:text="@string/cancel"
                    android:textColor="@color/instagram_color" />

            </LinearLayout>

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Squat Information -->
    <LinearLayout
        android:id="@+id/squatInfoLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/workout_session"
                android:textSize="12sp"
                android:textColor="@color/secondary_text"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/squatCountText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/initial_squats"
                android:textSize="26sp"
                android:fontFamily="sans-serif-medium"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/primary_text"
                android:textStyle="normal" />
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:text="@string/stand_in_front_camera"
            android:textColor="@color/secondary_text"
            android:accessibilityLiveRegion="polite"
            android:textSize="14sp" />


    </LinearLayout>

    <!-- Control Buttons -->
    <LinearLayout
        android:id="@+id/controlButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startWorkoutButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/start_workout"
            android:textSize="16sp"
            app:icon="@drawable/ic_play"
            app:iconGravity="textStart"
            android:backgroundTint="@color/start_color" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stopWorkoutButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/stop_workout"
                android:textSize="16sp"
                app:icon="@drawable/ic_stop"
                app:iconGravity="textStart"
                android:backgroundTint="@color/stop_color"
                android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
</androidx.core.widget.NestedScrollView>
