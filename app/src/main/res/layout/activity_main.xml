<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".MainActivity">

    <!-- Header with Instagram Time and Mode Toggle -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/header_background"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

                <TextView
                    android:id="@+id/instagramTimeText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/instagram_time_format"
                    android:textAppearance="?attr/textAppearanceBody1"
                    android:textColor="@color/primary_text" />

                <Button
                    android:id="@+id/openInstagramButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/instagram_color"
                    android:text="@string/open_instagram"
                    android:textColor="@android:color/white" />        </LinearLayout>

        <!-- Mode Selection -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/header_background"
            app:tabTextColor="@color/white"
            app:tabSelectedTextColor="@color/progress_color"
            app:tabIndicatorColor="@color/progress_color">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live Camera" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upload Video" />

        </com.google.android.material.tabs.TabLayout>

    </LinearLayout>

    <!-- Content Container -->
    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/squatInfoLayout">

        <!-- Live Camera View -->
        <LinearLayout
            android:id="@+id/cameraView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Camera Preview -->
            <androidx.camera.view.PreviewView
                android:id="@+id/cameraPreviewView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Pose Detection Overlay -->
            <com.workout2scroll.ui.PoseOverlayView
                android:id="@+id/poseOverlayView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </LinearLayout>

        <!-- Video Upload View -->
        <LinearLayout
            android:id="@+id/videoUploadLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <!-- Video Selection -->
            <ImageView
                android:id="@+id/ivVideoIcon"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@android:drawable/ic_menu_gallery"
                android:tint="@color/progress_color"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvVideoHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select a video to analyze squats"
                android:textColor="@color/primary_text"
                android:textSize="16sp"
                android:layout_marginBottom="24dp"
                android:gravity="center" />

                <Button
                    android:id="@+id/selectVideoButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/instagram_color"
                    android:text="Select Video"
                    android:textColor="@android:color/white" />

            <!-- Video Processing Layout -->
            <LinearLayout
                android:id="@+id/videoProcessingLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/processingStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Processing video..."
                    android:textAppearance="?attr/textAppearanceSubtitle1"
                    android:textColor="@color/primary_text" />

                <ProgressBar
                    android:id="@+id/processingProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:progress="0" />

            </LinearLayout>        </LinearLayout>

    </FrameLayout>

    <!-- Squat Information -->
    <LinearLayout
        android:id="@+id/squatInfoLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@color/card_background"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/controlButtons"
        app:layout_constraintTop_toBottomOf="@id/contentContainer">

            <TextView
                android:id="@+id/squatCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/squat_count_format"
                android:textAppearance="?attr/textAppearanceHeadline4"
                android:textColor="@color/primary_text"
                android:textStyle="bold" />        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:text="Stand in front of camera to start"
            android:textColor="@color/secondary_text"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/progress_color" />

    </LinearLayout>

    <!-- Control Buttons -->
    <LinearLayout
        android:id="@+id/controlButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/startWorkoutButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/start_workout"
            android:textSize="16sp"
            android:backgroundTint="@color/start_color" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
